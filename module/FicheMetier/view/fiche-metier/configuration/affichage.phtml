<?php

use FicheMetier\Entity\Db\Activite;
use FicheMetier\Entity\Db\ActiviteElement;
use FicheMetier\Entity\Db\FicheMetier;
use FicheMetier\Entity\Db\Mission;
use FicheMetier\Entity\Db\MissionElement;
use FicheMetier\Provider\Parametre\FicheMetierParametres;
use UnicaenParametre\Entity\Db\Parametre;

/**
 * @see \FicheMetier\Controller\FicheMetierConfigurationAffichageController::indexAction()
 * @var Parametre[] $parametres
 */

$mode = 'affichage';

$fiche = new FicheMetier();
$fiche->setId(0);
$fiche->setLibelle("Fiche de métier pour le paramètrage");
$fiche->setReference("TEST");
$fiche->setRaison("Fiche métier temporaire pour tester le paramètrage de l'affichage des fiches métiers");

$missions = [];
$missionLibelles = [
        1 => "Première mission capitale",
        2 => "Deuxième mission importante",
        3 => "Troisième et dernière mission"
];
foreach ($missionLibelles as $position => $libelle) {
    $mission = new Mission();
    $mission->setLibelle($libelle);
    $missionElement  = new MissionElement(); $missionElement->setMission($mission); $missionElement->setPosition($position);
    $missions[] = $missionElement;
}

$activites = [];
$activiteLibelles = [
        1 => "actividad número uno",
        2 => "zweite Aktivität ",
        3 => "Saigo no akutibiti"
];
foreach ($activiteLibelles as $position => $libelle) {
    $activite = new Activite();
    $activite->setLibelle($libelle);
    $activiteElement  = new ActiviteElement(); $activiteElement->setActivite($activite); $activiteElement->setPosition($position);
    $activites[] = $activiteElement;
}

?>


