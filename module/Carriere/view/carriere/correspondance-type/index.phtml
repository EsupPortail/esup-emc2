<?php

use Carriere\Entity\Db\CorrespondanceType;
use Carriere\Provider\Privilege\CorrespondancePrivileges;

/**
 * @see \Carriere\Controller\CorrespondanceTypeController::indexAction()
 * @var CorrespondanceType[] $types
 */

$this->headTitle("Types de spécialité");


$canAfficher = $this->isAllowed(CorrespondancePrivileges::getResourceId(CorrespondancePrivileges::CORRESPONDANCE_AFFICHER));
$canAjouter     = $this->isAllowed(CorrespondancePrivileges::getResourceId(CorrespondancePrivileges::CORRESPONDANCE_AJOUTER));
$canModifier    = $this->isAllowed(CorrespondancePrivileges::getResourceId(CorrespondancePrivileges::CORRESPONDANCE_MODIFIER));
$canSupprimer   = $this->isAllowed(CorrespondancePrivileges::getResourceId(CorrespondancePrivileges::CORRESPONDANCE_SUPPRIMER));

$now = new DateTime();
?>

<div class="row">
    <div class="col-md-9">
        <h1 class="page-header">
            Types de spécialité
        </h1>
    </div>
    <div class="col-md-3">
        <a href="<?php echo $this->url('correspondance'); ?>"
           class="btn btn-secondary"
        >
            <span class="icon icon-lister"></span>
            Accéder aux spécialités
        </a>
    </div>
</div>

<?php if ($canAjouter) : ?>
    <?php /** @see \Carriere\Controller\CorrespondanceTypeController::ajouterAction() */ ?>
    <a href="<?php echo $this->url('carriere/correspondance-type/ajouter', [], [], true); ?>"
       class="btn btn-primary ajax-modal" data-event="modification"
    >
        <span class="icon icon-ajouter"></span>
        Ajouter un type de spécialité
    </a>
<?php endif; ?>

<!---->
<!--<div class="col-md-6 alert alert-info" style="margin-top: 1rem;">-->
<!--    <span class="icon icon-refresh"></span>-->
<!--    Données synchronisées-->
<!--</div>-->


<table class="table table-condensed table-hover" id="types">
    <thead>
    <tr>
        <th class="col-md-1"> Code </th>
        <th class="col-md-2"> Libellé court </th>
        <th class="col-md-6"> Libellé long </th>
        <th class="col-md-1"> Source </th>
        <th class="col-md-2"> Action </th>
    </tr>
    </thead>
    <tbody>
        <?php foreach ($types as $type) : ?>
        <tr>
            <td>
                <code><?php echo $type->getCode(); ?></code>
                <?php if ($type->getDescription() !== null AND trim($type->getDescription()) !== '') : ?>
                    <span class="icon icon-information" title="<?php echo $type->getDescription(); ?>"></span>
                <?php endif; ?>
            </td>
            <td> <?php echo $type->getLibelleCourt(); ?> </td>
            <td>
                <?php echo $type->getLibelleLong(); ?>
                <?php if ($type->getDateFermeture() !== null and $type->getDateFermeture() < $now) : ?>
                    <span class="badge" style="background: darkred;">terminé</span>
                <?php endif; ?>
            </td>
            <td>
                <?php if ($type->getSourceId() === null) : ?>
                    <span class="missing-data">Aucune source connue</span>
                <?php else : ?>
                    <code> <?php echo $type->getSourceId(); ?> </code>
                <?php endif; ?>
            </td>
            <td class="action">
                <?php if ($canAfficher) : ?>
                    <?php /** @see \Carriere\Controller\CorrespondanceTypeController::afficherAction() */ ?>
                    <a href="<?php echo $this->url('carriere/correspondance-type/afficher', ['type' => $type->getId()], [], true); ?>"
                       class="ajax-modal action secondary">
                            <span class="icon icon-voir"></span>
                        Afficher
                    </a>
                <?php endif; ?>
                <?php if ($canModifier) : ?>
                    <br>
                    <?php /** @see \Carriere\Controller\CorrespondanceTypeController::modifierAction() */ ?>
                    <a href="<?php echo $this->url('carriere/correspondance-type/modifier', ['correspondance-type' => $type->getId()], [], true); ?>"
                       class="ajax-modal action primary" data-event="modification">
                        <span class="icon icon-editer"></span>
                        Modifier
                    </a>
                <?php endif; ?>
                <?php if ($canSupprimer) : ?>
                    <br>
                    <?php /** @see \Carriere\Controller\CorrespondanceTypeController::supprimerAction() */ ?>
                    <a href="<?php echo $this->url('carriere/correspondance-type/supprimer', ['correspondance-type' => $type->getId()], [], true); ?>"
                       class="ajax-modal action danger" data-event="modification">
                        <span class="icon icon-unchecked"></span>
                        Supprimer
                    </a>
                <?php endif; ?>
            </td>
        </tr>
        <?php endforeach; ?>
    </tbody>
</table>

<script>
    $(function() {
        $("body").on("modification", function (event) {
            event.div.modal('hide');
            window.location.reload();
        });

        $('table#types').DataTable({
            stateSave: true,
            autoWidth: false,
            language: {
                "url": "/js/datatables_fr.json",
            },
            columnDefs: [
                { targets: [3], orderable: false }
            ]
        });
    });
</script>
