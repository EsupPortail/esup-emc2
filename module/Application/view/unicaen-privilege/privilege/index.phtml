<script type="text/javascript">
    $(function () {

        $('body').on('click', 'a.modifier-privilege', function (e) {
            e.preventDefault();
            that = $(this);
            $.ajax({
                type: "GET",
                url: $(this).attr('href'),
                dataType: "html",
                beforeSend: function () {
                    that.find('i').attr('class', 'fas fa-pulse fa-spinner');
                },
                success: function (data) {
                    that.parent('td.role-privilege-statut').replaceWith(data);
                },
            });
        });
    });

    function masquerNamespace() {
        const element = event.currentTarget;
        const namespace = element.dataset.namespace;


        // Masquage des categories
        const rowsCategorie = document.querySelectorAll(
            `tr.categorie[data-namespace="${namespace}"]`
        );
        rowsCategorie.forEach(row => {
            row.style.display = "none";
        });
        // Masquage des privileges
        const rowsPrivileges = document.querySelectorAll(
            `tr.privilege[data-namespace="${namespace}"]`
        );
        rowsPrivileges.forEach(row => {
            row.style.display = "none";
        });
        toggleNamespaceVisibility(namespace);
        $('.toggle_namespace_'+ namespace).toggle();
    }

    function afficherNamespace() {
        const element = event.currentTarget;
        const namespace = element.dataset.namespace;
        console.log("Affichage du namespace", namespace);

        // Masquage des categories
        const rowsCategorie = document.querySelectorAll(
            `tr.categorie[data-namespace="${namespace}"]`
        );
        rowsCategorie.forEach(row => {
            row.style.display = "";
        });
        // Masquage des privileges
        // const rowsPrivileges = document.querySelectorAll(
        //     `tr.privilege[data-namespace="${namespace}"]`
        // );
        // rowsPrivileges.forEach(row => {
        //     row.style.display = "";
        // });
        toggleNamespaceVisibility(namespace);
        $('.toggle_namespace_'+ namespace).toggle();
    }

    function toggleNamespaceVisibility(namespace) {
        const rowsPrivileges = document.querySelectorAll(
            `span.toggleable[data-namespace="${namespace}"]`
        );
        rowsPrivileges.forEach(row => {
            if (row.style.display === "none") row.style.display = "";
            else row.style.display = "none";
        });
    }

    function toggleCategorie(categorie) {
        console.log("Categorie : " + categorie);
        console.log($('tr.categorie-id-'+categorie));
        $('tr.categorie-id-'+categorie).toggle();
    }
</script>