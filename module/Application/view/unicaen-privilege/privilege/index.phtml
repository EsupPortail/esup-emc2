<script type="text/javascript">

    let debug = 0;

    $(function () {
        $('body').on('click', 'a.modifier-privilege', function (e) {
            e.preventDefault();
            that = $(this);
            $.ajax({
                type: "GET",
                url: $(this).attr('href'),
                dataType: "html",
                beforeSend: function () {
                    that.find('i').attr('class', 'fas fa-pulse fa-spinner');
                },
                success: function (data) {
                    that.parent('td.role-privilege-statut').replaceWith(data);
                },
            });
        });
    });


    function masquerNamespace(namespace) {
        // manipulation des lignes du tableau
        if (debug > 10) console.log("Masquage du namespace " + namespace);
        $('tr[data-namespace="' + namespace + '"]').not('.namespace').addClass('hidden');
        // manipulation des icons du namespace
        $('span#close-namespace-' + namespace).hide()
        $('span#open-namespace-' + namespace).show()
        $('tr[data-namespace="' + namespace + '"] span.close-categorie').hide();
        $('tr[data-namespace="' + namespace + '"] span.open-categorie').show();
    }

    function closeAll() {
        let all = $('tr.namespace');
        if (debug > 5) console.log("Namespace à masquer : " + all.length);
        all.each((index, el) => {
            let id = $(el).data("namespace");  // Note: il faut utiliser $(el)
            masquerNamespace(id);
        });
        $('span#close-all').hide()
        $('span#open-all').show()
    }

    function afficherNamespace(namespace) {
        // manipulation des lignes du tableau
        if (debug > 10) console.log("Affichage du namespace " + namespace);
        $('tr[data-namespace="' + namespace + '"]').not('.namespace').removeClass('hidden');
        // manipulation des icons du namespace
        $('span#close-namespace-' + namespace).show()
        $('span#open-namespace-' + namespace).hide()
        $('tr[data-namespace="' + namespace + '"] span.close-categorie').show();
        $('tr[data-namespace="' + namespace + '"] span.open-categorie').hide();
    }

    function openAll() {
        let all = $('tr.namespace');
        if (debug > 5) console.log("Namespace à afficher : " + all.length);
        all.each((index, el) => {
            let id = $(el).data("namespace");  // Note: il faut utiliser $(el)
            afficherNamespace(id);
        });
        $('span#close-all').show()
        $('span#open-all').hide()
    }

    function masquerCategorie(categorie) {
        // manipulation des lignes du tableau
        if (debug > 10) console.log("Masquage de la catégorie " + categorie);
        $('tr[data-categorie="' + categorie + '"]').not('.catégorie').addClass('hidden');
        // manipulation des icons du namespace
        $('span#close-categorie-' + categorie).hide()
        $('span#open-categorie-' + categorie).show()
    }

    function afficherCategorie(categorie) {
        // manipulation des lignes du tableau
        if (debug > 10) console.log("Affichage de la catégorie " + categorie);
        $('tr[data-categorie="' + categorie + '"]').not('.catégorie').removeClass('hidden');
        // manipulation des icons du namespace
        $('span#close-categorie-' + categorie).show()
        $('span#open-categorie-' + categorie).hide()
    }

    document.addEventListener('DOMContentLoaded', function () {
        const table = document.getElementById('privilege-liste');
        const cells = table.querySelectorAll('tbody td.role-privilege-statut');

        cells.forEach(cell => {
            cell.addEventListener('mouseenter', function () {
                // Récupérer l'index de la colonne
                const colIndex = this.cellIndex;

                // Mettre en surbrillance cette cellule
                this.classList.add('hovered');

                // Mettre en surbrillance l'en-tête correspondant
                const theadRow = table.querySelector('thead tr');
                const headerCell = theadRow.children[colIndex];
                if (headerCell) {
                    headerCell.classList.add('highlight');
                }
            });

            cell.addEventListener('mouseleave', function () {
                // Enlever la surbrillance
                this.classList.remove('hovered');

                // Enlever la surbrillance de l'en-tête
                const colIndex = this.cellIndex;
                const theadRow = table.querySelector('thead tr');
                const headerCell = theadRow.children[colIndex];
                if (headerCell) {
                    headerCell.classList.remove('highlight');
                }
            });
        });
    });
</script>

