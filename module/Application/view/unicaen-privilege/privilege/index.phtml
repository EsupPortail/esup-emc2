<?php

use UnicaenPrivilege\Entity\Db\Privilege;
use UnicaenPrivilege\Entity\Db\PrivilegeCategorie;
use UnicaenPrivilege\Form\Privilege\CategorieFiltreForm;
use UnicaenUtilisateur\Entity\Db\RoleInterface;

/**
 * @var RoleInterface[] $roles
 * @var array $privilegesByCategorie
 * @var CategorieFiltreForm $form
 * @var ?string $gestion
 * @var ?string $namespace
 *
 * @see AdministrationController::privilegeAction()
 * @see PrivilegeController::indexAction()
 */

$this->headTitle("Gestion des privilèges");


$namespaces = [];
/**
 * @var  int $categorieId
 * @var  Privilege[] $privileges
 */
foreach ($privilegesByCategorie as $categorieId => $privileges) {
    $privilege = $privileges[array_key_first($privileges)];
    $categorie = $privilege->getCategorie();
    $namespaces[$categorie->getNamespace()][] = $categorie;
}

ksort($namespaces);
foreach ($namespaces as $namespace_ => $categories) {
    usort($categories, function (PrivilegeCategorie $a, PrivilegeCategorie $b) { return $a->getOrdre() <=> $b->getOrdre(); });
    $namespaces[$namespace_] = $categories;
}
//var_dump($namespaces);

?>

<h1 class="page-header">
    Gestion des privilèges
</h1>

<?php echo $this->messenger()->addMessagesFromFlashMessenger(); ?>


<?php if (!isset($gestion) or $gestion !== 'off') : ?>
    <div class="row mb-3">
        <div class="col-md-12">
            <?php /** @see PrivilegeCategorieController::indexAction() */ ?>
            <a href="<?php echo $this->url('unicaen-privilege/categorie', [], ["query" => ['namespace' => $namespace]], true); ?>"
               class="btn btn-primary">
                <i class="fas fa-crown"></i>
                Gestion des privilèges
            </a>
        </div>
    </div>
<?php endif; ?>

<table id="privilege-liste" class="table table-hover table-condensed table-header-rotated">
    <thead>
    <tr>
        <th></th>
        <?php $first = true;
        foreach ($roles as $role): ?>
            <th class="rotate-45" title="<?php echo $role; ?>">
                <div<?php if ($first) echo ' class="first"'; ?>><span><?php echo $role; ?></span></div>
            </th>
            <?php $first = false; endforeach; ?>
        <th></th>
    </tr>
    <tr>
        <th>Privilèges
<!--            <i title="Afficher / Masquer tous les privilèges" class="hide-privileges fas fa-caret-square-down"></i>-->
        </th>
        <th colspan="<?php echo count($roles); ?>">Rôles</th>
        <th style="min-width:166px"></th>
    </tr>
    </thead>
    <tbody>
    <?php $namespacePosition = 0; ?>
    <?php foreach ($namespaces as $namespace_ => $categories) : ?>
        <?php $namespacePosition++; ?>
    <tr style="width:100%">
        <th class="namespace" colspan="<?php echo 1 + count($roles); ?>" >
            Module <?php echo explode("\\",$namespace_)[0]; ?>
            <span id="toggle_namespace_<?php echo $namespacePosition; ?>" data-namespace="namespace_<?php echo $namespacePosition; ?>" class="icon icon-masquer toggleable" onclick="masquerNamespace(this)" style="display: none;"></span>
            <span id="toggle_namespace_<?php echo $namespacePosition; ?>" data-namespace="namespace_<?php echo $namespacePosition; ?>" class="icon icon-voir toggleable" onclick="afficherNamespace(this)" ></span>
        </th>
    </tr>
        <?php foreach ($categories as $categorie) : ?>
            <tr style="display: none;" class="categorie" id="<?php echo $categorie->getId(); ?>" data-namespace="namespace_<?php echo $namespacePosition; ?>">
            <th class="categorie" colspan="<?php echo 1 + count($roles); ?>" data-categorie="<?php echo $categorie->getId(); ?>" onclick="toggleCategorie(<?php echo $categorie->getId(); ?>)">
                <?php echo $categorie->getLibelle(); ?>
                <i class="toggle-categorie fas fa-caret-square-down" data-categorie="<?php echo $categorie->getId(); ?>" title="Afficher / Masquer les privilèges"></i>
            </th>
            </tr>
            <?php
                $privileges = $categorie->getPrivileges()->toArray();
                usort($privileges, function (Privilege $a, Privilege $b) {return $a->getOrdre() <=> $b->getOrdre(); });
            ?>

                <?php foreach ($privileges as $privilege) : ?>
                    <tr style="display: none;" class="privilege categorie-id-<?php echo $privilege->getCategorie()->getId(); ?>"  data-namespace="namespace_<?php echo $namespacePosition; ?>" ">
                        <td  class="privilege">
                            <?php echo $privilege; ?>
                        </td>
                        <?php foreach ($roles as $role): ?>
                            <?php echo $this->privilege($privilege)->renderStatut($role); ?>
                        <?php endforeach; ?>
                    </tr>
                <?php endforeach; ?>
        <?php endforeach; ?>



    <?php endforeach; ?>
    </tbody>
</table>

