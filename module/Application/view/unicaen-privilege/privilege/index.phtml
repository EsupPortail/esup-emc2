<?php

use UnicaenPrivilege\Entity\Db\Privilege;
use UnicaenPrivilege\Entity\Db\PrivilegeCategorie;
use UnicaenPrivilege\Form\Privilege\CategorieFiltreForm;
use UnicaenUtilisateur\Entity\Db\RoleInterface;

/**
 * @var RoleInterface[] $roles
 * @var array $privilegesByCategorie
 * @var CategorieFiltreForm $form
 * @var ?string $gestion
 * @var ?string $namespace
 *
 * @see AdministrationController::privilegeAction()
 * @see PrivilegeController::indexAction()
 */

$this->headTitle("Gestion des privilèges");


$namespaces = [];
/**
 * @var  int $categorieId
 * @var  Privilege[] $privileges
 */
foreach ($privilegesByCategorie as $categorieId => $privileges) {
    $privilege = $privileges[array_key_first($privileges)];
    $categorie = $privilege->getCategorie();
    $namespaces[$categorie->getNamespace()][] = $categorie;
}

ksort($namespaces);
foreach ($namespaces as $namespace_ => $categories) {
    usort($categories, function (PrivilegeCategorie $a, PrivilegeCategorie $b) {
        return $a->getOrdre() <=> $b->getOrdre();
    });
    $namespaces[$namespace_] = $categories;
}
//var_dump($namespaces);

?>

<h1 class="page-header">
    Gestion des privilèges
</h1>

<?php echo $this->messenger()->addMessagesFromFlashMessenger(); ?>


<?php if (!isset($gestion) or $gestion !== 'off') : ?>
    <div class="row mb-3">
        <div class="col-md-12">
            <?php /** @see PrivilegeCategorieController::indexAction() */ ?>
            <a href="<?php echo $this->url('unicaen-privilege/categorie', [], ["query" => ['namespace' => $namespace]], true); ?>"
               class="btn btn-primary">
                <i class="fas fa-crown"></i>
                Gestion des privilèges
            </a>
        </div>
    </div>
<?php endif; ?>

<table id="privilege-liste" class="table table-hover table-condensed table-header-rotated">
    <thead>
    <tr>
        <th>Privilèges
            <span class="icon icon-masquer toggleable" id="close-all" title="Masquer tous les modules"
                  onclick="closeAll()"></span>
            <span class="icon icon-voir toggleable" id="open-all" title="Afficher tous les modules" onclick="openAll()"
                  style="display: none;"></span>
        </th>
        <?php $first = true;
        foreach ($roles as $role): ?>
            <th class="role rotate-45" title="<?php echo $role; ?>">
                <div<?php if ($first) echo ' class="first"'; ?>><span><?php echo $role; ?></span></div>
            </th>
            <?php $first = false; endforeach; ?>
        <th></th>
        <th style="min-width:166px"></th>
    </tr>

    </thead>
    <tbody>
    <?php $namespacePosition = 0;
    $nbElementNamespace = count($namespaces); ?>
    <?php foreach ($namespaces as $namespace_ => $categories) : ?>
        <?php $namespacePosition++; ?>
        <tr class="namespace" data-namespace="<?php echo $namespacePosition; ?>">
            <th class="namespace" colspan="<?php echo 1 + count($roles); ?>">
                <?php if ($namespacePosition < $nbElementNamespace): ?>
                    ├─
                <?php else : ?>
                    └─
                <?php endif; ?>
                <?php
                    $moduleLibelle = explode("\\", $namespace_)[0];
                    if ($moduleLibelle === 'Element') $moduleLibelle = "Applications et Compétences"
                ?>
                &nbsp;<?php echo $moduleLibelle; ?>
                <span id="close-namespace-<?php echo $namespacePosition; ?>"
                      data-namespace="<?php echo $namespacePosition; ?>"
                      class="icon icon-masquer toggleable close"
                      onclick="masquerNamespace(<?php echo $namespacePosition; ?>)"></span>
                <span id="open-namespace-<?php echo $namespacePosition; ?>"
                      data-namespace="<?php echo $namespacePosition; ?>"
                      class="icon icon-voir toggleable open"
                      onclick="afficherNamespace(<?php echo $namespacePosition; ?>)" style="display: none;"></span>
            </th>
        </tr>
        <?php $categoriePosition = 0;
        $nbElementCategorie = count($categories); ?>
        <?php foreach ($categories as $categorie) : ?>
            <?php $categoriePosition++; ?>
            <tr class="catégorie" data-namespace="<?php echo $namespacePosition; ?>"
                data-categorie="<?php echo $categorie->getId(); ?>">
                <th class="catégorie" colspan="<?php echo 1 + count($roles); ?>">
                    │ &nbsp;
                    <?php if ($categoriePosition < $nbElementCategorie): ?>
                        ├─
                    <?php else : ?>
                        └─
                    <?php endif; ?>
                    &nbsp;<?php echo $categorie->getLibelle(); ?>
                    <span id="close-categorie-<?php echo $categorie->getId(); ?>"
                          data-namespace="<?php echo $namespacePosition; ?>"
                          data-categorie="<?php echo $categorie->getId(); ?>"
                          class="icon icon-masquer toggleable close-categorie"
                          onclick="masquerCategorie(<?php echo $categorie->getId(); ?>)"></span>
                    <span id="open-categorie-<?php echo $categorie->getId(); ?>"
                          data-namespace="<?php echo $namespacePosition; ?>"
                          data-categorie="<?php echo $categorie->getId(); ?>"
                          class="icon icon-voir toggleable open-categorie"
                          onclick="afficherCategorie(<?php echo $categorie->getId(); ?>)" style="display: none;"></span>
                </th>
            </tr>
            <?php
            $privileges = $categorie->getPrivileges()->toArray();
            usort($privileges, function (Privilege $a, Privilege $b) {
                return $a->getOrdre() <=> $b->getOrdre();
            });
            ?>
            <?php $privilegePosition = 0;
            $nbElementPrivilege = count($privileges); ?>
            <?php foreach ($privileges as $privilege) : ?>
                <?php $privilegePosition++; ?>
                <tr class="privilège categorie-id-<?php echo $privilege->getCategorie()->getId(); ?>"
                    data-namespace="<?php echo $namespacePosition; ?>"
                    data-categorie="<?php echo $categorie->getId(); ?>"
                >
                    <td class="privilège">
                        │ &nbsp;│ &nbsp;
                        <?php if ($privilegePosition < $nbElementPrivilege): ?>
                            ├─
                        <?php else : ?>
                            └─
                        <?php endif; ?>
                        &nbsp;<?php echo $privilege; ?>
                    </td>
                    <?php foreach ($roles as $role): ?>
                        <?php echo $this->privilege($privilege)->renderStatut($role); ?>
                    <?php endforeach; ?>
                </tr>
            <?php endforeach; ?>
        <?php endforeach; ?>


    <?php endforeach; ?>
    </tbody>
</table>

