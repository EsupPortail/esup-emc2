<?php

use Agent\Entity\Db\Agent;
use EntretienProfessionnel\Entity\Db\Campagne;
use Structure\Entity\Db\Observateur;
use Structure\Entity\Db\Structure;
use Structure\Entity\Db\StructureResponsable;
use Structure\Provider\Privilege\ResponsabilitePrivileges;
use Structure\Provider\Privilege\StructurePrivileges;
use Structure\Provider\Role\RoleProvider;
use UnicaenContact\Entity\Db\Contact;
use UnicaenContact\Entity\Db\Type;
use UnicaenContact\Provider\Privilege\ContactPrivileges;

/**
 * @see \Structure\Controller\StructureController::descriptionAction()
 * @var Structure $structure
 * @var Structure[] $selecteur
 *
 * @var Agent[] $responsables
 * @var Agent[] $gestionnaires
 * @var Observateur[] $observateurs
 * @var Contact[] $contacts
 *
 * @var Structure $niveau2
 * @var Structure $parent
 * @var Structure[] $filles
 *
 * @var Campagne[] $campagnes
 * @var Campagne[] $campagnesFutures
 *
 * PARAMETRES
 * @var bool $blocGestionnaire
 * @var bool $blocObservateur
 * @var bool $blocContact
 */

$this->headTitle($structure->getLibelleLong() . " - Description");


$responsabilite = new StructureResponsable();
$responsabilite->setStructure($structure);

$canAfficherResponsabilite = $this->isAllowed($responsabilite, ResponsabilitePrivileges::RESPONSABILITE_AFFICHER);
$canGererResponsabiliteInterne = $this->isAllowed($responsabilite,ResponsabilitePrivileges::RESPONSABILITE_GERER);
$canGererResponsabiliteSynchronisee = $this->isAllowed($responsabilite,ResponsabilitePrivileges::RESPONSABILITE_SYNCHRONISER);


$date = new DateTime();
$filles = array_filter($filles, function (Structure $s) use ($date) {
    return !$s->isDeleted();
});


?>

<?php echo $this->partial('partial/entete', ['structure' => $structure, 'campagnes' => $campagnes, 'campagnesFutures' => $campagnesFutures, 'current' => 'description', 'selecteur' => $selecteur]); ?>

<div class="row">
    <div class="col-md-6">
        <?php echo $this->partial('partial/description/informations', ['structure' => $structure]); ?>
        <?php echo $this->partial('partial/description/presentation', ['structure' => $structure]); ?>
        <?php echo $this->partial('partial/description/positionnement', ['structure' => $structure,  'parent' => $parent, 'filles' => $filles]); ?>
    </div>
    <div class="col-md-6">
        <?php echo $this->partial('partial/description/responsables', ['structure' => $structure, 'responsables' => $responsables,
                'canAfficherResponsabilite' => $canAfficherResponsabilite, 'canGererResponsabiliteInterne' => $canGererResponsabiliteInterne, 'canGererResponsabiliteSynchronisee' => $canGererResponsabiliteSynchronisee ]); ?>

        <?php if ($blocGestionnaire) : ?>
        <?php echo $this->partial('partial/description/gestionnaires', ['structure' => $structure, 'gestionnaires' => $gestionnaires,
                'canAfficherResponsabilite' => $canAfficherResponsabilite, 'canGererResponsabiliteInterne' => $canGererResponsabiliteInterne, 'canGererResponsabiliteSynchronisee' => $canGererResponsabiliteSynchronisee ]); ?>
        <?php endif; ?>
        <?php if ($blocObservateur) : ?>
            <?php echo $this->partial('partial/description/observateurs', ['structure' => $structure, 'observateurs' => $observateurs]); ?>
        <?php endif; ?>
        <?php if ($blocContact) : ?>
            <?php echo $this->partial('partial/description/contacts', ['structure' => $structure, 'contacts' => $contacts]); ?>
        <?php endif; ?>


    </div>
</div>













<script>
    $('button#informations-tab').addClass('active');
</script>