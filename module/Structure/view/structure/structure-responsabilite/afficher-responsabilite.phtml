        <h3>Passée</h3>

        <?php usort($terminees, function (StructureResponsable|StructureGestionnaire $a, StructureResponsable|StructureGestionnaire $b) {
            if ($a->getDateDebut()->format('Y-m-d') !== $b->getDateDebut()->format('Y-m-d')) {
                return $a->getDateDebut() <=> $b->getDateDebut();
            }
            return $a->getAgent()->getDenomination() <=> $b->getAgent()->getDenomination();
        });
        ?>
        <ul>
            <?php foreach ($terminees as $responsabilite) : ?>
                <?php $agent = $responsabilite->getAgent(); ?>
