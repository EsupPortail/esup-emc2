<?php

/**
 * @var Structure[] $structures
 */

use Structure\Entity\Db\Structure;
use UnicaenContact\Entity\Db\Contact;

?>

<table class="table table-condensed" id="contacts">
    <thead>
    <tr>
        <th class="col-md-5"> Structure </th>
        <th class="col-md-5"> Type </th>
        <th class="col-md-5"> Contact </th>
        <th class="col-md-2 action"> Action </th>
    </tr>
    </thead>
    <tbody>
    <?php foreach ($structures as $structure): ?>
        <?php /** @var Contact $contact */ ?>
        <?php foreach ($structure->getContacts() as $contact): ?>
            <tr>
                <td data-column-id="Structure">
                    <?php if ($structure->getNiv2() AND $structure->getNiv2() !== $structure) : ?>
                        <?php echo $structure->getNiv2()->getLibelleCourt(); ?> >
                    <?php endif; ?>
                    <?php echo $structure->getLibelleLong(); ?><br>
                    <?php echo $structure->getType()->getLibelle(); ?>
                </td>
                <td data-column-id="Type">
                    <?php echo $contact->getType()->getLibelle(); ?> <br>
                    <code><?php echo $contact->getType()->getCode(); ?></code>
                </td>
                <td data-column-id="Contact">
                    <?php echo $contact->getPrenom(); ?> <?php echo $contact->getNom(); ?><br>
                    <?php if ($contact->getTelephone()) : ?>
                        <?php echo $contact->getTelephone(); ?><br>
                    <?php endif; ?>
                    <?php echo $contact->getEmail(); ?>
                </td>
                <td></td>
            </tr>
        <?php endforeach; ?>
    <?php endforeach; ?>
    </tbody>
</table>
